# Upstash Redis (Vercel → Storage → Upstash for Redis створить ці змінні сам)
KV_REST_API_URL=
KV_REST_API_TOKEN=
# або при прямому акаунті Upstash:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Пуш-сповіщення: пара ключів — один раз згенерувати командою `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# власник сповіщень (вимога протоколу Web Push)
VAPID_SUBJECT=mailto:you@example.com
# секрет для Vercel Cron (будь-який довгий випадковий рядок)
CRON_SECRET=

# На Vercel: вимкнути тестові DEV-дії на сервері (монети, ачівки, скидання гри)
DISABLE_DEV_TOOLS=1

# Фото етикетки → калорії й БЖВ (Gemini, Google AI Studio). Без ключа кнопки фото просто немає.
GEMINI_API_KEY=
# необов'язково: модель і скільки викликів на добу дозволено (сайт відкритий — це захищає кредит)
# GEMINI_MODEL=gemini-3.8-flash
# AI_DAILY_LIMIT=20
