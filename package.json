{
  "name": "calories_tracker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "npm run build && node scripts/dev.mjs --preview",
    "typecheck": "tsc -b",
    "icons": "pwa-assets-generator --preset minimal-2023 public/favicon.svg",
    "dev:vercel": "vercel dev",
    "test": "node --test tests/*.test.js",
    "seed": "node scripts/seed.mjs"
  },
  "dependencies": {
    "@fontsource/exo-2": "^5.3.0",
    "@fontsource/play": "^5.3.0",
    "@upstash/redis": "1.41.0",
    "barcode-detector": "3.2.3",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "framer-motion": "^14.14.0",
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "web-push": "^4.0.0",
    "zustand": "^5.1.0",
    "zxing-wasm": "3.1.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0"
